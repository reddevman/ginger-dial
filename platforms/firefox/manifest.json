{
  "manifest_version": 3,
  "name": "Ginger Dial",
  "version": "1.0.0",
  "description": "Una nueva pestaña visual, rápida y privada. Todos los datos permanecen en este navegador.",
  "permissions": ["storage", "bookmarks"],
  "optional_host_permissions": ["<all_urls>"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Abrir Ginger Dial"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ginger-dial@amarqara.local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
